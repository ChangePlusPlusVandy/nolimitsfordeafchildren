{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".open-next",
    ".next",
    "dist",
    // Bundled by wrangler (wrangler.jsonc "main"), NOT by Next/tsc.
    // Imports the build-generated `.open-next/worker.js`, which only exists
    // after `opennextjs-cloudflare build` runs.
    "worker.ts"
  ]
}
