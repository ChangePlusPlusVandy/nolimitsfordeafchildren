{
  "name": "nolimits-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter nolimits-app dev",
    "build": "pnpm --filter nolimits-app build",
    "preview": "pnpm --filter nolimits-app preview",
    "deploy": "pnpm --filter nolimits-app deploy",
    "cf-typegen": "pnpm --filter nolimits-app cf-typegen",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter nolimits-app db:generate",
    "db:seed": "pnpm --filter nolimits-app db:seed",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check .",
    "test:e2e": "pnpm --filter nolimits-e2e test",
    "test:e2e:ui": "pnpm --filter nolimits-e2e test:ui"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
