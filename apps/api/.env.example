# Server
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Database
# For local development (docker-compose up db -d):
POSTGRES_URI=postgresql://user:password@localhost:5432/database

# S3 Storage
# For local development with MinIO (docker-compose up minio minio-init -d):
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nolimits-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# For production (DigitalOcean Spaces), replace with:
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET_NAME=nolimitsfordeafchildren-prod
# S3_REGION=sfo3
# S3_ENDPOINT=https://sfo3.digitaloceanspaces.com

# Authentication
# Set AUTH_DISABLED=true to bypass auth in local demo mode
AUTH_DISABLED=true

# For production, set AUTH_DISABLED=false and configure Better Auth:
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret

# Optional: comma-separated emails that should auto-receive administrator role on first sign-up
BOOTSTRAP_ADMIN_EMAILS=
