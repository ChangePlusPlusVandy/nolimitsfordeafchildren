# Server
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Database
# For local development (docker-compose up db -d):
POSTGRES_URI=postgresql://user:password@localhost:5432/database

# S3 Storage
# For local development with MinIO (docker-compose up minio minio-init -d):
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nolimits-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000

# For production (DigitalOcean Spaces), replace with:
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET_NAME=nolimitsfordeafchildren-prod
# S3_REGION=sfo3
# S3_ENDPOINT=https://sfo3.digitaloceanspaces.com

# Auth0
# Set AUTH_DISABLED=true to bypass authentication in development
AUTH_DISABLED=true

# For production, set AUTH_DISABLED=false and configure:
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.nolimits.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
