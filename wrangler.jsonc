{
	// OpenNext on Cloudflare (Next.js 16, nodejs runtime).
	// `main` is our custom worker: it re-exports the handler generated by
	// `opennextjs-cloudflare build` (`.open-next/worker.js`) and adds a
	// `scheduled` handler for Cron Triggers. Wrangler bundles this file itself.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nolimitsfordeafchildren",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-01",
	// nodejs runtime is required (edge is deprecated/broken in Next 16 + OpenNext).
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			// Staging D1 database created by the user; local dev uses wrangler's
			// emulated D1 (remote=false) — remote migrations are never applied
			// automatically, only via `wrangler d1 migrations apply --remote`.
			"database_name": "nolimits-d1-staging",
			"database_id": "dfbcb92f-3dc5-45e3-ba81-4067ce11cc32",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			// Staging R2 bucket created by the user
			// (account endpoint cd0db0257b50e56cf8b1d020ffbfff0e).
			"bucket_name": "nolimits-r2-staging"
		}
	],
	"send_email": [
		{
			// Cloudflare Email Workers binding.
			// Email stays EXPLICITLY DISABLED until EMAIL_FROM_ADDRESS is set
			// to a from-address VERIFIED in the Cloudflare dashboard
			// (Workers & Pages -> Email -> Settings); until then
			// `src/lib/email.ts` returns failure loudly (never fakes success).
			"name": "EMAIL"
		}
	],
	// Cron Triggers (Cloudflare runs these in UTC).
	// "0 16 * * *" = 8:00 AM PT (PDT, UTC-7). "0 17 * * 1" = 9:00 AM PT Monday (PDT).
	// NOTE: during PST (UTC-8) these fire 1h later local time (DST drift) —
	// Cloudflare crons cannot express TZ-aware schedules; acceptable for
	// daily/weekly notification jobs.
	"triggers": {
		"crons": [
			"0 16 * * *",
			"0 17 * * 1"
		]
	}
}