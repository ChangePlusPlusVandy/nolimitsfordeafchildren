{
	// OpenNext on Cloudflare (Next.js 16, nodejs runtime).
	// `main` is our custom worker: it re-exports the handler generated by
	// `opennextjs-cloudflare build` (`.open-next/worker.js`) and adds a
	// `scheduled` handler for Cron Triggers. Wrangler bundles this file itself.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nolimitsfordeafchildren",
	"main": "./worker.ts",
	"compatibility_date": "2026-07-01",
	// nodejs runtime is required (edge is deprecated/broken in Next 16 + OpenNext).
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nolimits-db",
			// Replace with the real D1 database id (`wrangler d1 create nolimits-db`)
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			// Create the bucket first: wrangler r2 bucket create nolimits-bucket
			"bucket_name": "nolimits-bucket"
		}
	],
	"send_email": [
		{
			// Cloudflare Email Workers binding.
			// The FROM-address must be verified in the Cloudflare dashboard
			// (Workers & Pages -> Email) before emails can be sent; until then
			// `src/lib/email.ts` gracefully no-ops with a console.warn.
			"name": "EMAIL"
		}
	],
	// Cron Triggers (Cloudflare runs these in UTC).
	// "0 16 * * *" = 8:00 AM PT (PDT, UTC-7). "0 17 * * 1" = 9:00 AM PT Monday (PDT).
	// NOTE: during PST (UTC-8) these fire 1h later local time (DST drift) —
	// Cloudflare crons cannot express TZ-aware schedules; acceptable for
	// daily/weekly notification jobs.
	"triggers": {
		"crons": ["0 16 * * *", "0 17 * * 1"]
	}
}